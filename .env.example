# ──────────────────────────────────────────────────────────────────────────
# Industrial Dashboard — Environment Variables
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────────────

# ── App / Auth ──────────────────────────────────────────────────────────────
SESSION_SECRET_KEY=change-me-to-a-random-32-char-string
API_SECRET_KEY=change-me-for-ai-endpoint-access
ENVIRONMENT=development

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./industrial.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/industrial

# ── PaddleOCR Model Cache ─────────────────────────────────────────────────────
# Where PaddleOCR downloads its models (~500 MB on first run).
# Defaults to ~/.paddleocr if not set.
PADDLE_HOME=/Users/you/.paddleocr

# ── Ollama (local LLM) ────────────────────────────────────────────────────────
# URL of your local Ollama instance (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
# Model to use for AI analysis (auto-pulled by start.sh if missing)
OLLAMA_MODEL=gemma4:12b
